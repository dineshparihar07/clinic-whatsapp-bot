# ─── WhatsApp (Meta Cloud API) ───────────────────────────────────────────────
WHATSAPP_TOKEN=              # Bearer token from Meta for Developers
WHATSAPP_PHONE_NUMBER_ID=    # Phone Number ID from Meta dashboard
WHATSAPP_VERIFY_TOKEN=       # Any random string you choose for webhook verification

# ─── Google Gemini ────────────────────────────────────────────────────────────
GEMINI_API_KEY=              # From Google AI Studio (aistudio.google.com)

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=                # postgres://user:pass@host/dbname

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=         # e.g. https://your-project.vercel.app
CRON_SECRET=                 # Random secret to protect /api/cron/* routes
